{
  "name": "katman-image-to-3mf",
  "version": "3.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "start:web": "node server.mjs",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "test:desktop": "node tests/desktop-smoke.mjs"
  },
  "dependencies": {
    "earcut": "3.0.2",
    "fflate": "0.8.2",
    "manifold-3d": "3.5.4",
    "potrace": "2.1.8",
    "three": "0.180.0",
    "three-bvh-csg": "0.0.18",
    "three-mesh-bvh": "0.9.17"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.10"
  },
  "main": "desktop/main.cjs",
  "description": "Gorselden vektor ve renkli 3D kabartma olusturan masaustu uygulamasi"
}
